# Ignore everything at the root
/*

# Allow only the required root files
!/pom.xml
!/README.md
!/.gitignore

# Allow only the two Maven modules
!/mini-sec-core/
!/mini-sec-jwt/

# Inside modules, ignore everything by default
/mini-sec-core/*
/mini-sec-jwt/*

# Allow source code and Maven POMs
!/mini-sec-core/src/
!/mini-sec-core/pom.xml
!/mini-sec-jwt/src/
!/mini-sec-jwt/pom.xml

# Keep all files and subdirectories inside src
/mini-sec-core/src/**
!/mini-sec-core/src/**/
/mini-sec-jwt/src/**
!/mini-sec-jwt/src/**/