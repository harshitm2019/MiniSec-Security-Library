# Ignore everything by default
/*

# Ignore IDE configuration
/.idea/

# Allow root-level required files
!/pom.xml
!/MiniSec-README.md
!/.gitignore

# Allow module directories
!/mini-sec-core/
!/mini-sec-jwt/

# Allow required files and directories recursively
!**/src/
!**/src/**
!**/pom.xml
!**/README.md
!**/.gitignore